#!/bin/sh
# DroidSpaces direct-V4L2 Firefox launcher. No sandbox is disabled here.
# Firefox 160 GNU/Linux AArch64 only: the RDD preload adds explicit KGSL ioctl
# allowances, protects cached descriptors and rejects exec/io_uring. Other
# syscall decisions continue through the original policy.
# Install the locked forkserver preference with configure-firefox-vaapi.sh.
set -eu
compat_lib=${DMD_FIREFOX_HEAP_LIB:-/usr/local/lib/droidspaces-firefox/libdmd-firefox-compat.so}
firefox_bin=${DMD_FIREFOX_BIN:-/usr/bin/firefox}
fail() { printf 'firefox-hwdec: %s\n' "$*" >&2; exit 1; }
case "$compat_lib" in /*) ;; *) fail 'DMD_FIREFOX_HEAP_LIB must be absolute' ;; esac
case "$compat_lib" in *[[:space:]:]*) fail 'preload path cannot contain whitespace/colons' ;; esac
[ -f "$compat_lib" ] && [ -r "$compat_lib" ] || fail "compatibility library missing: $compat_lib"
case "$firefox_bin" in /*) ;; *) fail 'DMD_FIREFOX_BIN must be an absolute executable path' ;; esac
[ -x "$firefox_bin" ] || fail "Firefox executable missing: $firefox_bin"
case "$(basename -- "$firefox_bin")" in firefox-hwdec|firefox-msm-vaapi) fail 'DMD_FIREFOX_BIN points to a launcher' ;; esac
if [ "$(readlink -f -- "$firefox_bin")" = "$(readlink -f -- "$0")" ]; then
    fail 'DMD_FIREFOX_BIN would recurse into this launcher'
fi
if env | LC_ALL=C grep -Eq '^MOZ_DISABLE_[A-Za-z0-9_]*SANDBOX=.+$'; then
    fail 'remove inherited MOZ_DISABLE_*SANDBOX variables; Mozilla sandboxes must stay enabled'
fi
[ "$(uname -s)" = Linux ] && [ "$(uname -m)" = aarch64 ] || fail 'supported only on native GNU/Linux AArch64'
case "$(getconf GNU_LIBC_VERSION 2>/dev/null || :)" in
    glibc\ *) ;;
    *) fail 'supported only with GNU libc' ;;
esac
firefox_version=$("$firefox_bin" --version 2>/dev/null) || fail 'could not query Firefox version'
printf '%s\n' "$firefox_version" | LC_ALL=C grep -Eq '(^|[[:space:]])Firefox[[:space:]]+160([.[:space:]]|$)' || fail "only Firefox 160 is validated: $firefox_version"
if [ "${1:-}" = '--dmd-check' ]; then
    printf 'Firefox: %s (%s)\nRDD compatibility preload: %s\n' "$firefox_bin" "$firefox_version" "$compat_lib"
    printf '%s\n' 'Adds the explicit RDD KGSL ioctl policy; Mozilla sandboxes are not disabled.'
    printf '%s\n' 'Requires locked dom.ipc.forkserver.enable=false; run configure-firefox-vaapi.sh --verify.'
    exit 0
fi
[ "$(id -u)" -ne 0 ] || fail 'launch Firefox as the desktop user, not root'
# Override inherited kgsl/zink only for this process and its children.
export MESA_LOADER_DRIVER_OVERRIDE=msm
export MOZ_ENABLE_WAYLAND=1
export DMD_FIREFOX_KGSL=1
# Preserve all inherited preload libraries; do not set a global library path.
export LD_PRELOAD="$compat_lib${LD_PRELOAD:+:$LD_PRELOAD}"
exec "$firefox_bin" "$@"
