# Build artifacts
*.o
*.d
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb
# Driver crashes can leave core dumps of several hundred MB in the working directory.
core
core.[0-9]*

# Build output
# Anchor these patterns so a source directory of the same name is still tracked.
/build/
/client/build/

# Editor and IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
/tmp/
*.tmp
*.temp

# Test files
*.h264
*.mp4
*.mkv
*.avi
# VA-API driver build outputs
vaapi-driver/build/
vaapi-driver/build-*/

# Release outputs are uploaded as GitHub Release assets.
rel/
ksu-module/dmd-probe
