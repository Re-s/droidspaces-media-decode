# SELinux policy rules for decode-daemon
# These rules allow decode-daemon to create and use Unix sockets

# Define a new domain for decode-daemon
type decode_daemon, domain;
type decode_daemon_exec, exec_type, file_type;

# Allow init to start decode-daemon
init_daemon_domain(decode_daemon)

# Allow decode_daemon to create and use Unix sockets
allow decode_daemon decode_daemon:unix_stream_socket { create connect listen accept bind getattr getopt setopt shutdown read write };

# Allow decode_daemon to use file descriptors
allow decode_daemon decode_daemon:fd use;

# Allow decode_daemon to access device files (for hardware access)
allow decode_daemon device:chr_file { open read write ioctl map };

# Allow decode_daemon to access memory allocation
allow decode_daemon hal_graphics_allocator_default:fd use;

# Allow decode_daemon to interact with surfaceflinger
allow surfaceflinger decode_daemon:fd use;

# Allow decode_daemon to interact with graphics composer
allow hal_graphics_composer_default decode_daemon:fd use;

# Allow decode_daemon to access /tmp/anland directory
allow decode_daemon tmpfs:dir { search write add_name remove_name };
allow decode_daemon tmpfs:file { create read write unlink };

# Allow decode_daemon to access socket file
allow decode_daemon decode_daemon:sock_file { create read write unlink };

# Allow decode_daemon to bind to socket
allow decode_daemon self:unix_stream_socket { create bind listen accept read write };

# Allow decode_daemon to use process capabilities
allow decode_daemon self:capability { sys_ptrace sys_admin };

# Allow decode_daemon to access media codec
allow decode_daemon media:fd use;
allow decode_daemon mediacodec:fd use;

# Allow decode_daemon to access dmabuf
allow decode_daemon dmabuf_device:chr_file { open read write ioctl map };

# Additional permissions for hardware access
allow decode_daemon gpu_device:chr_file { open read write ioctl map };
allow decode_daemon kgsl_device:chr_file { open read write ioctl map };